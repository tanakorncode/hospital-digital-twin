# Copy to .env (git-ignored) and fill in.
# First start only: the administrator account created when the user table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-8-chars
# SQLite file (default: apps/api/data/hospital.db)
# DB_PATH=/var/lib/hospital-digital-twin/hospital.db
# Hours a sign-in lasts (default 12 = one shift)
# SESSION_HOURS=12
# Allowed web origins, comma-separated (localhost is always allowed)
# WEB_ORIGIN=https://hospital.example.org
# PORT=4000
# Hospital systems (HIS adapter, kiosks) → POST /ingest/live and /ingest/queue with "Authorization: Bearer <token>".
# Leave empty to switch ingestion off. Use a long random value: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# INGEST_TOKEN=
# Demo occupancy feed (stops by itself while the HIS adapter is sending): off to disable
# DEMO_FEED=on
# LINE Official Account notifications (Messaging API channel). All three set = on; webhook URL: https://<domain>/line/webhook
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_OA_ID=@123abcde

# Copy to .env (git-ignored) and fill in.
# First start only: the administrator account created when the user table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-8-chars
# SQLite file (default: apps/api/data/hospital.db)
# DB_PATH=/var/lib/hospital-digital-twin/hospital.db
# Hours a sign-in lasts (default 12 = one shift)
# SESSION_HOURS=12
# Allowed web origins, comma-separated (localhost is always allowed)
# WEB_ORIGIN=https://hospital.example.org
# PORT=4000
# Hospital systems (HIS adapter, kiosks) → POST /ingest/live and /ingest/queue with "Authorization: Bearer <token>".
# Leave empty to switch ingestion off. Use a long random value: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# INGEST_TOKEN=
# Demo occupancy feed (stops by itself while the HIS adapter is sending): off to disable
# DEMO_FEED=on
# LINE Official Account notifications (Messaging API channel). All three set = on; webhook URL: https://<domain>/line/webhook
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_OA_ID=@123abcde
# LINE Login for the patient pages inside LINE (LIFF). The LIFF app's LINE Login channel id, and the LIFF id.
# LINE_LOGIN_CHANNEL_ID=1650000000
# LINE_LIFF_ID=1650000000-AbCdEfGh
# Hours a patient's app session lasts (default 24)
# PATIENT_SESSION_HOURS=24
# Test only: sign in on /liff as a made-up LINE user without LINE. Refused when NODE_ENV=production. Never with real patients.
# PATIENT_DEV_LOGIN=on
# The hospital's public address (links in LINE replies, e.g. map directions): https://queue.hospital.go.th
# PUBLIC_URL=
# What the LINE bot answers to "ติดต่อเจ้าหน้าที่" (phone, opening hours)
# HOSPITAL_CONTACT=โทร 043-000-000 ต่อ 1234 (จันทร์–ศุกร์ 08:00–16:00)
# Digital Reception kiosks (/reception) read approved answers aloud with a Thai voice installed on the kiosk (never a
# cloud voice). "off" = captions only on every kiosk.
# RECEPTION_SPEECH=off
